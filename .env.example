# Copiez ce fichier en .env et renseignez vos valeurs. Ne versionnez jamais .env.
# Toutes les variables sont optionnelles : sans elles, Xam-Xam utilise le provider mock
# et la génération vidéo est désactivée.

# API Kiriku (TTS / STT) des organisateurs du KVICC : URL complète de chaque route.
# Exemple : KVICC_TTS_URL=https://<hôte>/v1/audio/speech
#           KVICC_STT_URL=https://<hôte>/v1/audio/transcriptions
# KVICC_API_KEY est la clé d'équipe sk-kiriku-... reçue par mail ou WhatsApp.
KVICC_TTS_URL=
KVICC_STT_URL=
KVICC_API_KEY=

# API TimaLens (génération de clips vidéo, service propriétaire optionnel)
TIMALENS_API_KEY=

# Bot WhatsApp (API WhatsApp Cloud de Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Gemini : clé et nom du modèle (aucun modèle par défaut)
GEMINI_API_KEY=
GEMINI_MODEL=

# Clé HMAC pour hacher les identifiants dans les logs (longue chaîne aléatoire)
LOG_HASH_KEY=

# Numéros exemptés de la limite par utilisateur, séparés par des virgules (équipe, démos)
UNLIMITED_NUMBERS=

# Réglages optionnels (valeurs par défaut entre parenthèses)
# XAMXAM_CACHE_DIR=            # dossier des caches TTS et STT (.cache)
# XAMXAM_GROUPING_WINDOW_SECONDS=  # regroupement photo + note vocale (8)
# XAMXAM_MAX_EXPLANATION_CHARS=    # longueur maximale de l'explication (1000)
# XAMXAM_USER_REQUESTS_PER_HOUR=   # demandes par élève et par heure (10)
# XAMXAM_NUMBER_LANGUAGE=          # nombres en lettres : fr ou wo (fr)
# XAMXAM_MESSAGES_PATH=            # JSON remplaçant les textes wolof du bot
# WHATSAPP_GRAPH_API_VERSION=      # version de l'API Graph (v23.0)
