# Copiez ce fichier en .env et renseignez vos valeurs. Ne versionnez jamais .env.
# Minimum pour le bot : les 4 variables WhatsApp + RODIUM_API_KEY (ou GEMINI_API_KEY).
# Kiriku (voix) et TimaLens (vidéo) sont optionnels. Les tests n'ont besoin d'aucune clé.

# --- Obligatoire : bot WhatsApp (API WhatsApp Cloud de Meta) --------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chaîne de votre choix, à recopier dans la configuration du webhook chez Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Recommandé : RodiumAI, cerveau de l'agent et lecture des photos --------------------
RODIUM_API_KEY=
# Modèle principal et modèle de repli (les identifiants sont ceux du catalogue Rodium).
# RODIUM_MODEL=google/gemini-3.8-flash
# RODIUM_FALLBACK_MODEL=google/gemini-3.7-flash

# --- Compatibilité avec les anciens déploiements Gemini direct -------------------------
# Utilisé si RODIUM_API_KEY n'est pas renseignée.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# --- Optionnel : voix wolof (API Kiriku du KVICC) --------------------------------------
# Sans ces trois variables, le bot répond en texte et ne peut pas écouter les notes vocales.
# Exemple : KVICC_TTS_URL=https://<hôte>/v1/audio/speech
#           KVICC_STT_URL=https://<hôte>/v1/audio/transcriptions
KVICC_TTS_URL=
KVICC_STT_URL=
KVICC_API_KEY=

# --- Optionnel : vidéo narrée en wolof (API TimaLens, clé tlak_…) ----------------------
# Avec une clé, l'agent lance une vidéo quand l'élève ne comprend pas ou la demande.
# L'aperçu est gratuit, le rendu consomme des crédits TimaLens.
TIMALENS_API_KEY=
# Plafond de crédits par vidéo : au-delà, le rendu n'est pas lancé (vide = pas de plafond).
TIMALENS_MAX_CREDITS=
# TIMALENS_VOICE=soynade_wo_female   # ou soynade_wo_male

# --- Optionnel : exploitation -----------------------------------------------------------
# Clé HMAC pour hacher les identifiants dans les logs (longue chaîne aléatoire)
LOG_HASH_KEY=
# Numéros exemptés de la limite par utilisateur, séparés par des virgules (équipe, démos)
UNLIMITED_NUMBERS=
# Explication produite en français puis traduite en wolof (désactivé : aucun traducteur choisi)
TRANSLATE_FROM_FRENCH=false

# Réglages optionnels (valeurs par défaut entre parenthèses)
# XAMXAM_CACHE_DIR=            # dossier du cache des audios d'explication (.cache)
# XAMXAM_STATE_DIR=            # dossier SQLite du bot (par défaut XAMXAM_CACHE_DIR)
# XAMXAM_GROUPING_WINDOW_SECONDS=  # regroupement photo + note vocale (8)
# XAMXAM_MAX_EXPLANATION_CHARS=    # longueur maximale de l'explication (1000)
# XAMXAM_USER_REQUESTS_PER_HOUR=   # messages par élève et par heure (30)
# XAMXAM_VIDEOS_PER_DAY=           # vidéos par élève et par jour (5)
# XAMXAM_MEMORY_MINUTES=           # mémoire de conversation, en RAM (60)
# XAMXAM_REPLY_MODE=               # audio : réponses uniquement vocales ; texte (audio)
# XAMXAM_WAITING_STICKER=          # autocollant « Néggal tuuti » à chaque message (true)
# XAMXAM_NUMBER_LANGUAGE=          # nombres en lettres : fr ou wo (fr)
# XAMXAM_AUDIO_SELF_CHECK=true     # formule TTS contrôlée par STT Kiriku (false)
# XAMXAM_MESSAGES_PATH=            # JSON remplaçant les textes wolof du bot
# XAMXAM_ENABLE_DEV_ROUTES=        # /dev/speak local uniquement (false)
# WHATSAPP_GRAPH_API_VERSION=      # version de l'API Graph (v23.0)
