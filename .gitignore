# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Environnements virtuels
.venv/
venv/
env/

# Secrets : ne jamais versionner le fichier .env
.env
.env.*
!.env.example

# Sorties générées (audio, transcriptions, rapports) et cache audio
outputs/
.cache/

# Terraform : état, plugins et valeurs locales (jamais versionnés)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
.terraform.lock.hcl.bak
crash.log

# Test local du déploiement (secrets factices, cache)
deploy/aws/.local/

# Éditeurs / OS
.vscode/
.idea/
.DS_Store

# Documentation officielle des organisateurs : ne jamais en versionner de copie
openapi*.json
swagger*.json
