[Unit]
Description=Xam-Xam : chargement des secrets SSM dans /run/xamxam (tmpfs)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/xamxam/xamxam.env
ExecStart=/opt/xamxam/load-secrets.sh
# Les secrets disparaissent quand le service s'arrête.
ExecStop=/usr/bin/rm -rf /run/xamxam

[Install]
WantedBy=multi-user.target
